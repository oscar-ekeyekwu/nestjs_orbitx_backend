DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orbitx_db

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5050

# STG-1 — at-rest crypto for storage provider credentials.
# 32 raw bytes encoded as base64 (preferred) or hex. Generate one with:
#   openssl rand -base64 32
# Loaded once at boot. Losing this means admins must re-enter every
# storage provider credential from scratch; leaking it + DB access lets
# an attacker decrypt the credentials. Production deploys should target
# KMS / Vault and rotate this on a schedule (key_version column makes
# rotation non-destructive).
STORAGE_KEK=

# DigitalOcean Spaces — KYC document storage (ARCH-9 + STG-1 bootstrap).
# OPTIONAL. These vars are read EXACTLY ONCE — by the STG-1 bootstrap
# migration (1780876900000-SeedStorageProviderFromEnv.ts) — and then
# become inert. After the migration runs, the `storage_providers` row
# is the source of truth; subsequent credential changes happen via the
# admin UI (STG-2). You can blank these env vars on subsequent deploys.
#
# Greenfield deploys with no legacy Spaces credentials can leave SPACES_KEY
# and SPACES_SECRET blank — the migration logs a hint and skips the seed.
# Create the first provider via the admin UI (/settings/storage) before
# any KYC document upload is attempted.
#
# The bucket MUST be private. Public reads are denied by bucket policy;
# clients only ever get short-lived presigned URLs (5 min for PUT,
# 15 min for GET per NFR-S2). Default endpoint is NYC3.
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=orbit-kyc-v1
SPACES_KEY=
SPACES_SECRET=
