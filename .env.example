DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orbitx_db

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5050

# DigitalOcean Spaces — KYC document storage (ARCH-9)
# The bucket MUST be private. Public reads are denied by bucket policy;
# clients only ever get short-lived presigned URLs (5 min for PUT,
# 15 min for GET per NFR-S2). Default endpoint is NYC3.
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=orbit-kyc-v1
SPACES_KEY=
SPACES_SECRET=
